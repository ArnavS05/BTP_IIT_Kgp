float a[1024],b[1024];
float third;
int i,step;

// Initial profile, with fixed endpoints.
third=0.3333333333333333;
i=0;
while(i<1024) {
    a[i]=i%31;
    b[i] =0.0;
    i=i+1;
}
a[0]=0.0;
a[1023] =100.0;

step=0;
while(step<8) {
    // Read the old profile into a separate new profile.
    i=1;
    while(i<1023) {
        b[i]=third*(a[i-1]+a[i]+a[i+1]);
        i =i+1;
    }

    // Commit this step; endpoints remain fixed.
    i=1;
    while(i<1023) {
        a[i] =b[i];
        i=i+1;
    }
    step=step+1;
}

